{
  "name": "bookly-support-agent",
  "version": "1.0.0",
  "description": "Conversational AI customer support agent for Bookly, built on the Anthropic Messages API.",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently -n server,frontend -c blue,green \"nodemon\" \"esbuild src/frontend/chat.ts --bundle --outfile=public/chat.js --watch\"",
    "build": "tsc && esbuild src/frontend/chat.ts --bundle --outfile=public/chat.js --minify",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.3.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    }
  }
}
